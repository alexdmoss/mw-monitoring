{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>alexos-platform/renovate:automerge"],
  "constraints": {
    "python": "==3.13.*"
  },
  "packageRules": [
    {
      "description": "Majors of the stack itself (Prometheus, Alertmanager, Grafana, exporters) are upgraded by hand",
      "matchFileNames": [".gitlab-ci.yml"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
